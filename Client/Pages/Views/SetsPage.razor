@page "/sets"
@using BlazorPokemonCardSetViewer.Components
@using BlazorPokemonCardSetViewer.Features.PokemonSet
@using BlazorPokemonCardSetViewer.Pages.ViewModels
@inject ISetsPageViewModel ViewModel
@inject ILogger<SetsPage> Logger
@implements IDisposable

<style>
    .main-content {
        margin: 7rem auto 2rem auto;
        min-width: 37.5rem;
        max-width: 106rem;
    }
    .sets-grid {
        position: relative;
        padding: 0.75rem 1rem;
        margin-bottom: 0;
        margin-top: 0;
        box-sizing: border-box;
        display: block;
        color: #0f1111;
        font-size: 14px;
        line-height: 20px;
    }
    .cards-section {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        row-gap: 0.75rem;
        column-gap: .75rem;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        list-style-type: disc;
        color: #0f1111;
        font-family: "Amazon Ember", Arial, sans-serif;
        font-size: 14px;
        line-height: 20px;
    }
    .card-container {
        display: flex;
        flex: 1 1 0;
        max-width: 26rem;
        position: relative;
        box-sizing: border-box;
        margin: 0;
        color: #0f1111;
        flex-direction: column;
        align-items: center;
        min-width: 26rem;
        height: 15rem;
        border-radius: 1rem;
        background-color: white;
        border: 1px solid #e3e3e3;
        padding-top: 0.75rem;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .image-container {
        height: 8rem;
        width: 13rem;
    }
    .card-image-small {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        width: 26rem;
        height: 7.81rem;
        overflow: hidden;
        padding: 1rem;
    }
    .card-title {
        font-size: 1rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }
    .card-subtitle {
        font-size: 0.7rem;
        color: #666;
    }
    .card-text {
        font-size: 0.8rem;
        margin-bottom: 0.25rem;
    }
    .gray-pokeball-container {
        height: 35.94rem;
        width: 35.94rem;
        display: flex;
        margin: auto;
        justify-content: center;
        align-items: center;
    }
    .gray-pokeball{
        height: 35.94rem;
        width: 35.94rem;
        filter: opacity(3.5%) grayscale(100%);
    }

</style>

<div class="main-content">
    <div class="sets-grid">
        @if (ViewModel.PagedSets != null)
        {
            <ul class="cards-section">
                @foreach (var set in ViewModel.PagedSets.Data)
                {
                    <li class="card-container">
                        @if (!string.IsNullOrEmpty(set.ImageLogo))
                        {
                            <div class="image-container">
                                <img class="card-image-small" src="@set.ImageLogo" alt="@set.Name">
                            </div>
                        }
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(set.Series!.ToString()))
                            {
                                <h6 class="card-subtitle mb-2 text-muted">@set.Series Series</h6>
                            }
                            @if (!string.IsNullOrEmpty(set.ReleaseDate.ToString()))
                            {
                                <h6 class="card-text">Release Date: @set.ReleaseDate?.ToString("MMMM dd, yyyy")</h6>
                            }
                            <h5 class="card-title">@set.Name</h5>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
        <div style="display: flex; flex-direction: column; margin: auto;">
            <div style="width: 100%;">
                <div class="alert alert-info">
                    Loading Sets...
                </div>
            </div>
            <div class="gray-pokeball-container">
                <img class="gray-pokeball" src="icons/pokeball_logo.svg" alt="Pokeball Logo"/>
            </div>
        </div>
        }
    </div>
</div>

@code {

    protected override async Task OnInitializedAsync()
    {
        ViewModel.CurrentPage = 1;
        await ViewModel.LoadSets();
    }

    public void Dispose()
    {

    }
}
